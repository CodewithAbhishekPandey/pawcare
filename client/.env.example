# PawCare Frontend Environment Variables
# Copy this to .env.local for local dev, or set as Vercel environment variables

# Backend API URL
# Development: http://localhost:5000
# Production: https://pawcare-backend.onrender.com  (your Render URL)
VITE_API_URL=http://localhost:5000

# Zegocloud (optional — video calls work only if set)
# Get these from https://console.zegocloud.com
VITE_ZEGO_APP_ID=
VITE_ZEGO_SERVER_SECRET=
